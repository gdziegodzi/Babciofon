{
  "expo": {
    "name": "Babciofon",
    "slug": "babciofon",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "babciofon",
    "newArchEnabled": false,
    "android": {
      "package": "com.babciofon",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.CALL_PHONE",
        "android.permission.SEND_SMS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Aplikacja potrzebuje dostępu do kontaktów, aby umożliwić ich import."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aplikacja używa lokalizacji do dołączenia jej do alarmowej wiadomości SMS."
        }
      ],
      "expo-asset",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickCall",
              "label": "Babciofon - Szybkie dzwonienie",
              "description": "Ulubione kontakty i alarm SMS na ekranie głównym",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}